{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "afterlight-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "afterlight-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=server/.env", "server/index.js"],
      "port": 4400
    }
  ]
}
