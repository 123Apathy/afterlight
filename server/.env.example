# Copy to server/.env (gitignored) and fill in real values from the Supabase
# dashboard. Never commit real keys to this file.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Secret (service-role) key — preferred. Required once RLS is locked down
# (see server/migrations/afterlight-rls-lockdown.sql for the cutover order).
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY

# Publishable key — legacy fallback, only used if SUPABASE_SECRET_KEY is unset.
SUPABASE_KEY=YOUR-PUBLISHABLE-KEY

# Owner dashboard secret (path + X-Admin-Secret header). Rotate if ever exposed.
ADMIN_SECRET=GENERATE-A-LONG-RANDOM-VALUE

# Comma-separated extra browser origins allowed to call the API (CORS).
# everlit.co.za + localhost dev ports are always allowed.
# ALLOWED_ORIGINS=https://staging.everlit.co.za

PORT=4400
